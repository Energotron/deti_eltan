      "Operations": [
        {
          "Type": "Top", "Name": "Run global", "Pos.x": 160, "Pos.y": 40,
          "Parent": -1, "#": 5, "Total.Lines": 1, "Code.Type": "Global",
          "Code": ["GRun();"]
        },
        {
          "Type": "Top", "Name": "Adapter smoke", "Pos.x": 240, "Pos.y": 80,
          "Parent": -1, "#": 6, "Total.Lines": 53, "Code.Type": "Turn",
          "Code": [
            "unknown ceSmoke = ImportedFunction('CESecondMapAdapter','CEAdapterRunSmoke');",
            "ceSmoke(GalaxyPtr(),1128616787);",
            "unknown ceProbe = ImportedFunction('CESecondMapAdapter','CEAdapterProbeGalaxy');",
            "ceProbe(GalaxyPtr(),64);",
            "unknown ceLayout = ImportedFunction('CESecondMapAdapter','CEAdapterObserveGalaxyLayout');",
            "ceLayout(GalaxyPtr(),1128616787,CurTurn());",
            "unknown ceActiveArm = ImportedFunction('CESecondMapAdapter','CEAdapterActiveArm');",
            "unknown ceStatus = ImportedFunction('CESecondMapAdapter','CEAdapterSecondGalaxyStatus');",
            "if(ceActiveArm()==0)",
            "{",
            "    int ceGenerationStatus = ceStatus();",
            "    if(ceGenerationStatus==0)",
            "    {",
            "        unknown ceEngineProbe = ImportedFunction('CESecondMapAdapter','CEAdapterProbeEngineGalaxy');",
            "        if(ceEngineProbe(GalaxyPtr())!=0)",
            "        {",
            "            unknown ceCreateSecond = ImportedFunction('CESecondMapAdapter','CEAdapterCreateAndEnterSecondGalaxy');",
            "            int ceSecondSeed = Rnd(1000001,2000000000,CurTurn()*7919+GalaxyStars()*104729);",
            "            if(ceCreateSecond(GalaxyPtr(),ceSecondSeed,ShipPilotRace(Player()))>0)",
            "                Ether(6,'CE_SecondHome_Ready','Тест «Детей Эльтан»: вторая галактика сгенерирована. Пропустите ещё один день — произойдёт переход во Второй Дом.');",
            "            else",
            "                Ether(6,'CE_SecondHome_Fail','Тест «Детей Эльтан»: генерация второй галактики не удалась, повторим на следующий день.');",
            "        }",
            "    } else if(ceGenerationStatus==2)",
            "    {",
            "        unknown ceEnterSecond = ImportedFunction('CESecondMapAdapter','CEAdapterEnterReadySecondGalaxy');",
            "        unknown ceAbandon = ImportedFunction('CESecondMapAdapter','CEAdapterAbandonEmptySecondGalaxy');",
            "        unknown ceDump = ImportedFunction('CESecondMapAdapter','CEAdapterDumpGalaxyWords');",
            "        unknown ceStarCount = ImportedFunction('CESecondMapAdapter','CEAdapterGetGeneratedStarCount');",
            "        unknown ceStarAt = ImportedFunction('CESecondMapAdapter','CEAdapterGetGeneratedStarByIndex');",
            "        int ceSecondSeed2 = CurTurn()*7919+15485863;",
            "        ceDump(GalaxyPtr(),100);",
            "        if(ceEnterSecond(GalaxyPtr())!=0)",
            "        {",
            "            ceDump(GalaxyPtr(),200);",
            "            int ceStars = ceStarCount(GalaxyPtr());",
            "            if(ceStars>0)",
            "            {",
            "                dword ceTargetStar = ceStarAt(GalaxyPtr(),Rnd(0,ceStars-1,ceSecondSeed2));",
            "                TransferShip(Player(),ceTargetStar);",
            "                ShipChangeStar(Player(),ceTargetStar);",
            "                SectorVisible(StarToCon(ceTargetStar),1);",
            "                StarMapLabel(ceTargetStar,'Второй Дом — временные врата Эльтан');",
            "                Ether(6,'CE_SecondHome_Enter','Тест «Детей Эльтан»: переход во Второй Дом выполнен. Это техническая карта без возврата в этой сборке.');",
            "            }",
            "            else",
            "            {",
            "                ceAbandon(GalaxyPtr());",
            "                Ether(6,'CE_SecondHome_Fail','Тест «Детей Эльтан»: вторая галактика пуста, возврат в старый рукав. Повторных попыток в этой партии не будет.');",
            "            }",
            "        }",
            "    }",
            "}"
          ]
        }
      ],
