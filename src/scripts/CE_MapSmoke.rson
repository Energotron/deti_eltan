  "Loops.Count": 0,
  "Visual.Objects": [
    {
      "Groups": [
        {
          "Type": "TGroup",
          "Name": "PlayerGroup",
          "Pos.x": 40,
          "Pos.y": 160,
          "Parent": -1,
          "#": 1,
          "Owner": 62,
          "Group.Type": 126,
          "CntShipMin": 1,
          "CntShipMax": 1,
          "SpeedMin": 100,
          "SpeedMax": 10000,
          "Weapon": 0,
          "CargoHook": 0,
          "EmptySpace": 0,
          "AddPlayer": true,
          "StatusTraderMin": 0,
          "StatusTraderMax": 100,
          "StatusWarriorMin": 0,
          "StatusWarriorMax": 100,
          "StatusPirateMin": 0,
          "StatusPirateMax": 100,
          "DistSearch": 10000,
          "Dialog": -1,
          "StrengthMin": "0",
          "StrengthMax": "0",
          "Ruins": ""
        }
      ],
      "Operations": [
        {
          "Type": "Top",
          "Name": "Run global",
          "Pos.x": 160,
          "Pos.y": 40,
          "Parent": -1,
          "#": 5,
          "Total.Lines": 1,
          "Code.Type": "Global",
          "Code": [
            "GRun();"
          ]
        },
        {
          "Type": "Top",
          "Name": "Adapter smoke",
          "Pos.x": 240,
          "Pos.y": 80,
          "Parent": -1,
          "#": 6,
          "Total.Lines": 293,
          "Code.Type": "Turn",
          "Code": [
            "//The star map re-entry is off. The turn code is bracketed by 400/401 and",
            "//those came out 308 to 308 -- it finishes every time, including the turn the",
            "//process dies on. So the fault is in what happens after it, and writing the",
            "//pending-form byte was the only thing left that reaches there. Form 16 is",
            "//the star map on the Steam build; Universe adds forms, and that index is",
            "//not something to assume. Skipping a day refreshes the panel anyway.",
            "unknown ceCheckExternalReload = ImportedFunction('CESecondMapAdapter','CEAdapterCheckForExternalReload');",
            "if(ceCheckExternalReload(GalaxyPtr())) Ether(6,'CE_ExternalReload','Второй Дом: связь со Вторым Домом потеряна (похоже, была загрузка сохранения), состояние сброшено.');",
            "unknown ceLogHeartbeat = ImportedFunction('CESecondMapAdapter','CEAdapterLogTurnHeartbeat');",
            "ceLogHeartbeat(CurTurn(),ShipInHole(Player()));",
            "unknown ceConsumeCameraRecenter = ImportedFunction('CESecondMapAdapter','CEAdapterConsumeCameraRecenterPending');",
            "if(ceConsumeCameraRecenter()) {",
            "  StarMapCenterView(CoordX(Player()),CoordY(Player()));",
            "  if(CurrentForm()=='StarMap') {",
            "    unknown ceClearCameraRecenter = ImportedFunction('CESecondMapAdapter','CEAdapterClearCameraRecenterPending');",
            "    ceClearCameraRecenter();",
            "  }",
            "}",
            "unknown ceInstallStarLookupRecovery = ImportedFunction('CESecondMapAdapter','CEAdapterInstallStarLookupRecovery');",
            "ceInstallStarLookupRecovery(GalaxyPtr());",
            "unknown ceInstallDayProcessRecovery = ImportedFunction('CESecondMapAdapter','CEAdapterInstallDayProcessRecovery');",
            "ceInstallDayProcessRecovery(GalaxyPtr());",
            "unknown ceInstallNextDayLabel3Recovery = ImportedFunction('CESecondMapAdapter','CEAdapterInstallNextDayLabel3Recovery');",
            "ceInstallNextDayLabel3Recovery(GalaxyPtr());",
            "unknown ceInstallDayCounterGuard = ImportedFunction('CESecondMapAdapter','CEAdapterInstallDayCounterGuard');",
            "ceInstallDayCounterGuard(GalaxyPtr());",
            "unknown ceInstallPostNextDayGuard = ImportedFunction('CESecondMapAdapter','CEAdapterInstallPostNextDayGuard');",
            "ceInstallPostNextDayGuard(GalaxyPtr());",
            "//Not diagnostics, whatever its name says. This hooks the call to LoadGame,",
            "//and what matters is what it does after: a load started from inside the game",
            "//queues no next form, so without it the engine finishes loading and sits at",
            "//a full progress bar with nothing to draw. Removing it as log noise is what",
            "//stranded the transit at 100 percent.",
            "unknown ceInstallLoadHook = ImportedFunction('CESecondMapAdapter','CEAdapterInstallLoadGameDiagnostics');",
            "ceInstallLoadHook(GalaxyPtr());",
            "unknown ceLogCheckpoint2 = ImportedFunction('CESecondMapAdapter','CEAdapterLogCheckpoint');",
            "//Asked before the block that arms it, not after. The portal completes on",
            "//every turn it is still open and re-arms each time, so a poll placed below",
            "//it was always looking at an arrival that had just been reset.",
            "unknown ceConsumePendingArrival = ImportedFunction('CESecondMapAdapter','CEAdapterConsumePendingArrival');",
            "dword ceArrivalReady = ceConsumePendingArrival();",
            "if(ShipInHole(Player())) {",
            "  unknown ceEnterPortal = ImportedFunction('CESecondMapAdapter','CEAdapterEnterRegisteredPortal');",
            "  ceEnterPortal(GalaxyPtr(),0);",
            "} else {",
            "  unknown cePortalStatus = ImportedFunction('CESecondMapAdapter','CEAdapterPortalStatus');",
            "  unknown ceCompletePortal = ImportedFunction('CESecondMapAdapter','CEAdapterCompleteRegisteredPortal');",
            "  unknown ceLogCheckpoint = ImportedFunction('CESecondMapAdapter','CEAdapterLogCheckpoint');",
            "  unknown ceActiveArmBeforeLoad = ImportedFunction('CESecondMapAdapter','CEAdapterActiveArm');",
            "  dword ceTargetArm = 0;",
            "  if(ceActiveArmBeforeLoad()==0) ceTargetArm=1;",
            "  if(cePortalStatus()==2 && ceCompletePortal(GalaxyPtr(),CurTurn())) {",
            "    ceLogCheckpoint(100);",
            "    unknown ceArmPendingArrival = ImportedFunction('CESecondMapAdapter','CEAdapterArmPendingArrival');",
            "    ceArmPendingArrival(ceTargetArm);",
            "    ceLogCheckpoint(101);",
            "    FormChange('GameLoad');",
            "  }",
            "}",
            "if(ceArrivalReady==1) {",
            "  unknown ceLogCheckpointArrival = ImportedFunction('CESecondMapAdapter','CEAdapterLogCheckpoint');",
            "  ceLogCheckpointArrival(110);",
            "  unknown ceStashReady = ImportedFunction('CESecondMapAdapter','CEAdapterPlayerStashReady');",
            "  unknown ceFetch = ImportedFunction('CESecondMapAdapter','CEAdapterFetchPlayerValue');",
            "  unknown ceClearStash = ImportedFunction('CESecondMapAdapter','CEAdapterClearPlayerStash');",
            "  unknown ceLoadStash = ImportedFunction('CESecondMapAdapter','CEAdapterLoadPlayerStash');",
            "  if(!ceStashReady()) ceLoadStash();",
            "  if(ceStashReady()) {",
            "    ShipMoney(Player(),ceFetch(0));",
            "    ceLogCheckpointArrival(135);",
            "    ShipSkill(Player(),0,ceFetch(1));",
            "    ShipSkill(Player(),1,ceFetch(2));",
            "    ShipSkill(Player(),2,ceFetch(3));",
            "    ShipSkill(Player(),3,ceFetch(4));",
            "    ShipSkill(Player(),4,ceFetch(5));",
            "    ShipSkill(Player(),5,ceFetch(6));",
            "    ShipFreeExp(Player(),ceFetch(7));",
            "    ceLogCheckpointArrival(136);",
            "    unknown ceSyncTurn = ImportedFunction('CESecondMapAdapter','CEAdapterSetGalaxyTurn');",
            "    ceSyncTurn(GalaxyPtr(),ceFetch(8));",
            "    ceLogCheckpointArrival(137);",
            "    unknown ceItemCount = ImportedFunction('CESecondMapAdapter','CEAdapterStashedItemCount');",
            "    unknown ceItemField = ImportedFunction('CESecondMapAdapter','CEAdapterStashedItemField');",
            "    //The captain who owns the Second Home save has a full factory kit bolted",
            "    //into their slots. Rebuilding the arriving gear on top of it produced",
            "    //two of everything, with the carried half loose in the hold. Strip",
            "    //the local kit first: artefacts, then the hold, then the hull last -- the",
            "    //hull has to be the final item out and the first item back, because slot 0",
            "    //of the item list is where the engine expects to find it. The counters are",
            "    //bounded so a refusal to remove cannot spin the turn code forever.",
            "    //The hull stays put and is edited in place. Taking it off left the ship",
            "    //hull-less for the length of the loop, and putting a fresh one back meant",
            "    //CreateHull, whose first argument is the hull class (ranger/military/pirate)",
            "    //and not the item type -- feeding it 42 read past the end of a table and",
            "    //killed the process. HullType/ItemSize/ItemLevel/ItemOwner say the same",
            "    //thing without ever detaching anything.",
            "    int ceStripArtSlot = 0;",
            "    int ceStripItemSlot = 1;",
            "    dword ceStripGuard = 0;",
            "    while(ShipArts(Player())>0 && ceStripGuard<128) {",
            "      GetArtFromShip(Player(),ceStripArtSlot);",
            "      ceStripGuard = ceStripGuard+1;",
            "    }",
            "    ceStripGuard = 0;",
            "    while(ShipItems(Player())>1 && ceStripGuard<192) {",
            "      GetItemFromShip(Player(),ceStripItemSlot);",
            "      ceStripGuard = ceStripGuard+1;",
            "    }",
            "    ceLogCheckpointArrival(144);",
            "    dword ceRestoreIdx = 0;",
            "    while(ceRestoreIdx<ceItemCount()) {",
            "      dword ceIType = ceItemField(ceRestoreIdx,0);",
            "      dword ceISize = ceItemField(ceRestoreIdx,1);",
            "      dword ceILevel = ceItemField(ceRestoreIdx,2);",
            "      dword ceIOwner = ceItemField(ceRestoreIdx,3);",
            "      dword ceISlot = ceItemField(ceRestoreIdx,4);",
            "      dword ceIWear = ceItemField(ceRestoreIdx,5);",
            "      dword ceISpec = ceItemField(ceRestoreIdx,6);",
            "      dword ceIMod = ceItemField(ceRestoreIdx,7);",
            "      dword ceIHullClass = ceItemField(ceRestoreIdx,8);",
            "      //One checkpoint per item, carrying the type, so a crash names the item",
            "      //instead of leaving the whole loop under suspicion.",
            "      ceLogCheckpointArrival(1000+ceIType);",
            "      unknown ceNewItem = 0;",
            "      if(ceIType==t_Hull) {",
            "        ceNewItem = ShipItems(Player(),0);",
            "        if(ceNewItem) {",
            "          HullType(ceNewItem,ceIHullClass);",
            "          ItemSize(ceNewItem,ceISize);",
            "          ItemLevel(ceNewItem,ceILevel);",
            "          ItemOwner(ceNewItem,ceIOwner);",
            "          Chameleon(Player());",
            "        }",
            "      }",
            "      //10..41 are the original artefacts, which live in their own list on the",
            "      //ship and only CreateArt makes. 43..67 is equipment and the original",
            "      //weapons, 72 a cistern, 71 a loose micromodule, 73 a probe. Everything",
            "      //left over -- custom artefacts and weapons, nodes, quest items -- has no",
            "      //Create call that works from numbers alone, so it is skipped rather than",
            "      //guessed at. The Anchor, the one quest item that matters, is re-granted",
            "      //by name below.",
            "      if(ceIType>=10 && ceIType<=41) ceNewItem = CreateArt(ceIType,ceIOwner);",
            "      if(ceIType>=43 && ceIType<=67) ceNewItem = CreateEquipment(ceIType,ceISize,ceILevel,ceIOwner);",
            "      if(ceIType==72) ceNewItem = CreateEquipment(ceIType,ceISize,ceILevel,ceIOwner);",
            "      if(ceIType==71 && ceIMod>0) ceNewItem = CreateMM(ceIMod-1);",
            "      if(ceIType==73) ceNewItem = CreateZond(ceILevel,ceIOwner);",
            "      if(ceNewItem) {",
            "        //Wear, akrin and micromodule were stashed with 1 added so that 0 could",
            "        //mean 'nothing recorded' -- a worn-out item reads 0 and -1 means no bonus.",
            "        if(ceIWear>0 && ceIWear<102 && ItemCanBeBroken(ceNewItem)) ItemDurability(ceNewItem,ceIWear-1);",
            "        if(ceIType>=t_Hull && ceIType<=67) {",
            "          if(ceISpec>0) EqSpecial(ceNewItem,ceISpec-1);",
            "          if(ceIMod>0) EqModule(ceNewItem,ceIMod-1);",
            "        }",
            "        if(ceIType!=t_Hull) {",
            "          AddItemToShip(Player(),ceNewItem);",
            "          if(ceISlot>0) ItemIsInUse(ceNewItem,Player(),1,ceISlot);",
            "        }",
            "      }",
            "      ceLogCheckpointArrival(2000+ceIType);",
            "      ceRestoreIdx = ceRestoreIdx+1;",
            "    }",
            "    ceLogCheckpointArrival(145);",
            "    //Goods are not items and no Create* call touches them; they are a per-type",
            "    //counter on the hold. Clear whatever the local captain was hauling, then",
            "    //put the carried cargo back.",
            "    dword ceGoodsIdx = 0;",
            "    unknown ceGoodsHere = 0;",
            "    unknown ceGoodsWant = 0;",
            "    while(ceGoodsIdx<8) {",
            "      ceGoodsHere = GoodsCount(Player(),ceGoodsIdx);",
            "      if(ceGoodsHere>0) ShipGoods(Player(),ceGoodsIdx,0-ceGoodsHere);",
            "      ceGoodsWant = ceFetch(9+ceGoodsIdx);",
            "      if(ceGoodsWant>0) ShipGoods(Player(),ceGoodsIdx,ceGoodsWant);",
            "      ceGoodsIdx = ceGoodsIdx+1;",
            "    }",
            "    ceLogCheckpointArrival(146);",
            "    //The Anchor is a quest item, so the restore loop above cannot rebuild it,",
            "    //and without it aboard there is no way back out of Second Home.",
            "    unknown ceAnchorHere = 0;",
            "    dword ceAnchorScan = 0;",
            "    while(ceAnchorScan<ShipItems(Player()) && !ceAnchorHere) {",
            "      unknown ceAnchorCand = ShipItems(Player(),ceAnchorScan);",
            "      if(ceAnchorCand && EquipmentImageName(ceAnchorCand)=='CE_Item_TwinHomeAnchor') ceAnchorHere = ceAnchorCand;",
            "      ceAnchorScan = ceAnchorScan+1;",
            "    }",
            "    if(!ceAnchorHere) {",
            "      unknown ceAnchorNew = CreateQuestItem('CE_Item_TwinHomeAnchor',None);",
            "      if(ceAnchorNew) AddItemToShip(Player(),ceAnchorNew);",
            "    }",
            "    ShipCalcParam(Player());",
            "    UpdateFormShip();",
            "    ceLogCheckpointArrival(138);",
            "    ceClearStash();",
            "  }",
            "  ShipDeleteCustomShipInfo(Player(),'CE_InterarmPortalWatch');",
            "  ceLogCheckpointArrival(130);",
            "  unknown ceNativeExitX = CoordX(Player());",
            "  unknown ceNativeExitY = CoordY(Player());",
            "  //Arrive where the loaded game already put the ship. The old code picked a",
            "  //star by distance and called TransferShip, a leftover from the",
            "  //days when the transition swapped galaxy pointers under a live game and the",
            "  //ship had to be dragged along by hand. Now that arriving IS a load, the ship",
            "  //is already somewhere valid, and moving it only tore the camera loose.",
            "  unknown ceArrivalStar = 0;",
            "  //The captain of the arriving world was docked, and this mod no longer moves",
            "  //the ship anywhere, so the traveller inherited a berth instead of open",
            "  //space. Undock into the very same system: no jump across the map, so",
            "  //nothing for the camera to lose.",
            "  unknown ceDockedPlanet = GetShipPlanet(Player());",
            "  unknown ceDockedRuins = GetShipRuins(Player());",
            "  unknown ceDockedStar = 0;",
            "  if(ceDockedPlanet) ceDockedStar = PlanetToStar(ceDockedPlanet);",
            "  if(!ceDockedStar && ceDockedRuins) ceDockedStar = ShipStar(ceDockedRuins);",
            "  if(ceDockedStar) TransferShip(Player(),ceDockedStar);",
            "  if(!GetShipPlanet(Player())) ceArrivalStar = ShipStar(Player());",
            "  if(!ceArrivalStar) ceArrivalStar = GalaxyStar(0);",
            "  if(ceArrivalStar) {",
            "  ceLogCheckpointArrival(131);",
            "    unknown ceHoleFrom = 0;",
            "    dword ceHoleScan = 0;",
            "    while(ceHoleScan<GalaxyStars() && !ceHoleFrom) {",
            "      unknown ceHoleCand = GalaxyStar(ceHoleScan);",
            "      if(ceHoleCand!=ceArrivalStar) ceHoleFrom = ceHoleCand;",
            "      ceHoleScan = ceHoleScan+1;",
            "    }",
            "    if(ceHoleFrom) {",
            "      //Bring the hole to the ship rather than the ship to the hole -- same",
            "      //picture on screen, no teleport, so the camera keeps its lock. This is",
            "      //the mirror of what the Anchor does on the departure side.",
            "      dword ceExitHole = HoleCreate2(ceHoleFrom,ceArrivalStar);",
            "      if(ceExitHole) {",
            "        HoleX2(ceExitHole,CoordX(Player())+350);",
            "        HoleY2(ceExitHole,CoordY(Player()));",
            "      }",
            "    }",
            "  }",
            "  ceLogCheckpointArrival(133);",
            "  unknown ceArrivalSector = 0;",
            "  if(ceArrivalStar) ceArrivalSector = StarToCon(ceArrivalStar);",
            "  ceLogCheckpointArrival(140);",
            "  if(ceArrivalSector) SectorVisible(ceArrivalSector,1);",
            "  ceLogCheckpointArrival(141);",
            "  dword ceSectorIndex = 0;",
            "  dword ceOpened = 0;",
            "  while(ceArrivalSector && ceSectorIndex<GalaxySectors() && ceOpened<3) {",
            "    unknown ceCandidateSector = GalaxySectors(ceSectorIndex);",
            "    if(ceCandidateSector!=ceArrivalSector && ConNear(ceArrivalSector,ceCandidateSector)) {",
            "      SectorVisible(ceCandidateSector,1);",
            "      ceOpened=ceOpened+1;",
            "    }",
            "    ceSectorIndex=ceSectorIndex+1;",
            "  }",
            "  ceLogCheckpointArrival(142);",
            "  unknown ceLogArrivalDiag = ImportedFunction('CESecondMapAdapter','CEAdapterLogArrivalDiagnostics');",
            "  ceLogArrivalDiag(ceNativeExitX,ceNativeExitY,CoordX(ceArrivalStar),CoordY(ceArrivalStar),GalaxyStars(),GalaxySectors(),ceArrivalSector,ceOpened);",
            "  ceLogCheckpointArrival(143);",
            "  unknown ceArmCameraRecenter = ImportedFunction('CESecondMapAdapter','CEAdapterArmCameraRecenter');",
            "  ceArmCameraRecenter();",
            "  ceLogCheckpointArrival(134);",
            "  //The greeting announces an order to take the ranger alive, so something has",
            "  //to be there to carry it out. BuyWarrior spawns a military ship at a planet;",
            "  //spawning them in the arrival system puts the interception on screen instead",
            "  //of leaving the message talking to an empty sky.",
            "  if(ceArrivalStar && StarPlanets(ceArrivalStar)>0) {",
            "    unknown ceEscortPlanet = StarPlanets(ceArrivalStar,0);",
            "    dword ceEscortIdx = 0;",
            "    while(ceEscortPlanet && ceEscortIdx<3) {",
            "      BuyWarrior(ceEscortPlanet);",
            "      ceEscortIdx = ceEscortIdx+1;",
            "    }",
            "  }",
            "  Ether(6,'CE_SecondHomeGreeting',CT('CE.Transit.SecondHomeGreeting'));",
            "  //Everything above lands while the engine is still inside the call that",
            "  //opens the star map, so the map on screen was drawn from the numbers the",
            "  //arriving save had, and only caught up when a day was skipped. FormChange",
            "  //cannot fix that: it sees the target form is the one already showing and",
            "  //takes a shorter path. The adapter writes the byte the main loop reads, so",
            "  //the next pass through it enters the map again with the world as it now is.",
            "  ceLogCheckpointArrival(112);",
            "}",
            "if(ceArrivalReady==2) {",
            "  unknown ceLogCheckpointReturn = ImportedFunction('CESecondMapAdapter','CEAdapterLogCheckpoint');",
            "  unknown ceStashReadyR = ImportedFunction('CESecondMapAdapter','CEAdapterPlayerStashReady');",
            "  unknown ceFetchR = ImportedFunction('CESecondMapAdapter','CEAdapterFetchPlayerValue');",
            "  unknown ceClearStashR = ImportedFunction('CESecondMapAdapter','CEAdapterClearPlayerStash');",
            "  unknown ceLoadStashR = ImportedFunction('CESecondMapAdapter','CEAdapterLoadPlayerStash');",
            "  if(!ceStashReadyR()) ceLoadStashR();",
            "  if(ceStashReadyR()) {",
            "    ShipMoney(Player(),ceFetchR(0));",
            "    ShipSkill(Player(),0,ceFetchR(1));",
            "    ShipSkill(Player(),1,ceFetchR(2));",
            "    ShipSkill(Player(),2,ceFetchR(3));",
            "    ShipSkill(Player(),3,ceFetchR(4));",
            "    ShipSkill(Player(),4,ceFetchR(5));",
            "    ShipSkill(Player(),5,ceFetchR(6));",
            "    ShipFreeExp(Player(),ceFetchR(7));",
            "    unknown ceSyncTurnR = ImportedFunction('CESecondMapAdapter','CEAdapterSetGalaxyTurn');",
            "    ceSyncTurnR(GalaxyPtr(),ceFetchR(8));",
            "    //The return leg carries the same cargo as the outbound one. Names are",
            "    //suffixed R because RScript refuses to see the same variable declared in",
            "    //two branches of the same script, even when only one branch can run.",
            "    unknown ceItemCountR = ImportedFunction('CESecondMapAdapter','CEAdapterStashedItemCount');",
            "    unknown ceItemFieldR = ImportedFunction('CESecondMapAdapter','CEAdapterStashedItemField');",
            "    int ceStripArtSlotR = 0;",
            "    int ceStripItemSlotR = 1;",
            "    dword ceStripGuardR = 0;",
            "    while(ShipArts(Player())>0 && ceStripGuardR<128) {",
            "      GetArtFromShip(Player(),ceStripArtSlotR);",
            "      ceStripGuardR = ceStripGuardR+1;",
            "    }",
            "    ceStripGuardR = 0;",
            "    while(ShipItems(Player())>1 && ceStripGuardR<192) {",
            "      GetItemFromShip(Player(),ceStripItemSlotR);",
            "      ceStripGuardR = ceStripGuardR+1;",
            "    }",
            "    dword ceRestoreIdxR = 0;",
            "    while(ceRestoreIdxR<ceItemCountR()) {",
            "      dword ceITypeR = ceItemFieldR(ceRestoreIdxR,0);",
            "      dword ceISizeR = ceItemFieldR(ceRestoreIdxR,1);",
            "      dword ceILevelR = ceItemFieldR(ceRestoreIdxR,2);",
            "      dword ceIOwnerR = ceItemFieldR(ceRestoreIdxR,3);",
            "      dword ceISlotR = ceItemFieldR(ceRestoreIdxR,4);",
            "      dword ceIWearR = ceItemFieldR(ceRestoreIdxR,5);",
            "      dword ceISpecR = ceItemFieldR(ceRestoreIdxR,6);",
            "      dword ceIModR = ceItemFieldR(ceRestoreIdxR,7);",
            "      dword ceIHullClassR = ceItemFieldR(ceRestoreIdxR,8);",
            "      ceLogCheckpointReturn(1000+ceITypeR);",
            "      unknown ceNewItemR = 0;",
            "      if(ceITypeR==t_Hull) {",
            "        ceNewItemR = ShipItems(Player(),0);",
            "        if(ceNewItemR) {",
            "          HullType(ceNewItemR,ceIHullClassR);",
            "          ItemSize(ceNewItemR,ceISizeR);",
            "          ItemLevel(ceNewItemR,ceILevelR);",
            "          ItemOwner(ceNewItemR,ceIOwnerR);",
            "          Chameleon(Player());",
            "        }",
            "      }",
            "      if(ceITypeR>=10 && ceITypeR<=41) ceNewItemR = CreateArt(ceITypeR,ceIOwnerR);",
            "      if(ceITypeR>=43 && ceITypeR<=67) ceNewItemR = CreateEquipment(ceITypeR,ceISizeR,ceILevelR,ceIOwnerR);",
            "      if(ceITypeR==72) ceNewItemR = CreateEquipment(ceITypeR,ceISizeR,ceILevelR,ceIOwnerR);",
            "      if(ceITypeR==71 && ceIModR>0) ceNewItemR = CreateMM(ceIModR-1);",
            "      if(ceITypeR==73) ceNewItemR = CreateZond(ceILevelR,ceIOwnerR);",
            "      if(ceNewItemR) {",
            "        if(ceIWearR>0 && ceIWearR<102 && ItemCanBeBroken(ceNewItemR)) ItemDurability(ceNewItemR,ceIWearR-1);",
            "        if(ceITypeR>=t_Hull && ceITypeR<=67) {",
            "          if(ceISpecR>0) EqSpecial(ceNewItemR,ceISpecR-1);",
            "          if(ceIModR>0) EqModule(ceNewItemR,ceIModR-1);",
            "        }",
            "        if(ceITypeR!=t_Hull) {",
            "          AddItemToShip(Player(),ceNewItemR);",
            "          if(ceISlotR>0) ItemIsInUse(ceNewItemR,Player(),1,ceISlotR);",
            "        }",
            "      }",
            "      ceLogCheckpointReturn(2000+ceITypeR);",
            "      ceRestoreIdxR = ceRestoreIdxR+1;",
            "    }",
            "    dword ceGoodsIdxR = 0;",
            "    unknown ceGoodsHereR = 0;",
            "    unknown ceGoodsWantR = 0;",
            "    while(ceGoodsIdxR<8) {",
            "      ceGoodsHereR = GoodsCount(Player(),ceGoodsIdxR);",
            "      if(ceGoodsHereR>0) ShipGoods(Player(),ceGoodsIdxR,0-ceGoodsHereR);",
            "      ceGoodsWantR = ceFetchR(9+ceGoodsIdxR);",
            "      if(ceGoodsWantR>0) ShipGoods(Player(),ceGoodsIdxR,ceGoodsWantR);",
            "      ceGoodsIdxR = ceGoodsIdxR+1;",
            "    }",
            "    unknown ceAnchorHereR = 0;",
            "    dword ceAnchorScanR = 0;",
            "    while(ceAnchorScanR<ShipItems(Player()) && !ceAnchorHereR) {",
            "      unknown ceAnchorCandR = ShipItems(Player(),ceAnchorScanR);",
            "      if(ceAnchorCandR && EquipmentImageName(ceAnchorCandR)=='CE_Item_TwinHomeAnchor') ceAnchorHereR = ceAnchorCandR;",
            "      ceAnchorScanR = ceAnchorScanR+1;",
            "    }",
            "    if(!ceAnchorHereR) {",
            "      unknown ceAnchorNewR = CreateQuestItem('CE_Item_TwinHomeAnchor',None);",
            "      if(ceAnchorNewR) AddItemToShip(Player(),ceAnchorNewR);",
            "    }",
            "    ShipCalcParam(Player());",
            "    UpdateFormShip();",
            "    ceClearStashR();",
            "  }",
            "  ceLogCheckpointReturn(120);",
            "  ShipDeleteCustomShipInfo(Player(),'CE_InterarmPortalWatch');",
            "  unknown ceReturnSector = StarToCon(ShipStar(Player()));",
            "  if(SectorVisible(ceReturnSector)==0) SectorVisible(ceReturnSector,1);",
            "  unknown ceArmCameraRecenter2 = ImportedFunction('CESecondMapAdapter','CEAdapterArmCameraRecenter');",
            "  ceArmCameraRecenter2();",
            "  Ether(6,'CE_ArmSwitch_Return','Второй Дом: вы вернулись в исходный рукав Галактики.');",
            "  ceLogCheckpointReturn(122);",
            "}",
            "//Second Home housekeeping is off on this engine. Every piece of it has been",
            "//suspect in turn -- the nest seeding, the defender spawns, the sky -- and",
            "//each time removing one left the crash where it was. So the whole block",
            "//stands aside until there is evidence rather than another guess.",
            "//The two checkpoints below bracket the rest of the turn. If a turn still",
            "//ends the process with 400 logged and 401 missing, the fault is in what the",
            "//engine does after the turn code, not in the turn code at all.",
            "unknown ceLogTurnEdge = ImportedFunction('CESecondMapAdapter','CEAdapterLogCheckpoint');",
            "ceLogTurnEdge(400);",
            "unknown ceIsSecondHomeQuiet = ImportedFunction('CESecondMapAdapter','CEAdapterGalaxyIsSecondHome');",
            "dword ceInSecondHome = ceIsSecondHomeQuiet(GalaxyPtr());",
            "ceLogTurnEdge(401);"
          ]
        }
      ],
