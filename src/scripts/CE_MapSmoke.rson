          "Parent": -1, "#": 6, "Total.Lines": 119, "Code.Type": "Turn",
          "Code": [
            "unknown ceProbeRawPtr = ImportedFunction('CESecondMapAdapter','CEAdapterProbeRawGalaxyPointer');",
            "ceProbeRawPtr(GalaxyPtr(),CurTurn());",
            "unknown ceSmoke = ImportedFunction('CESecondMapAdapter','CEAdapterRunSmoke');",
            "ceSmoke(GalaxyPtr(),1128616787);",
            "unknown ceProbe = ImportedFunction('CESecondMapAdapter','CEAdapterProbeGalaxy');",
            "ceProbe(GalaxyPtr(),64);",
            "unknown ceLayout = ImportedFunction('CESecondMapAdapter','CEAdapterObserveGalaxyLayout');",
            "ceLayout(GalaxyPtr(),1128616787,CurTurn());",
            "unknown ceProbeVersion = ImportedFunction('CESecondMapAdapter','CEAdapterProbeSaveFormatVersion');",
            "ceProbeVersion(GalaxyPtr(),CurTurn());",
            "unknown ceSurveyClusters = ImportedFunction('CESecondMapAdapter','CEAdapterSurveyClusterList');",
            "ceSurveyClusters(GalaxyPtr());",
            "unknown ceCompareStarCon = ImportedFunction('CESecondMapAdapter','CEAdapterCompareStarConCounts');",
