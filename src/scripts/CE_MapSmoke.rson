            "//  unknown ceHideBossShipDeferred = ImportedFunction('CESecondMapAdapter','CEAdapterHideBossShip');",
            "//  unknown ceWasDominatorSweep = ImportedFunction('CESecondMapAdapter','CEAdapterWasDominator');",
