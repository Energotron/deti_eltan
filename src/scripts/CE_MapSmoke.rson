      "Operations": [
        {
          "Type": "Top", "Name": "Run global", "Pos.x": 160, "Pos.y": 40,
          "Parent": -1, "#": 5, "Total.Lines": 1, "Code.Type": "Global",
          "Code": ["GRun();"]
        },
        {
          "Type": "Top", "Name": "Adapter smoke", "Pos.x": 240, "Pos.y": 80,
          "Parent": -1, "#": 6, "Total.Lines": 117, "Code.Type": "Turn",
          "Code": [
            "unknown ceProbeRawPtr = ImportedFunction('CESecondMapAdapter','CEAdapterProbeRawGalaxyPointer');",
            "ceProbeRawPtr(GalaxyPtr(),CurTurn());",
            "unknown ceSmoke = ImportedFunction('CESecondMapAdapter','CEAdapterRunSmoke');",
            "ceSmoke(GalaxyPtr(),1128616787);",
            "unknown ceProbe = ImportedFunction('CESecondMapAdapter','CEAdapterProbeGalaxy');",
            "ceProbe(GalaxyPtr(),64);",
            "unknown ceLayout = ImportedFunction('CESecondMapAdapter','CEAdapterObserveGalaxyLayout');",
            "ceLayout(GalaxyPtr(),1128616787,CurTurn());",
            "unknown ceProbeVersion = ImportedFunction('CESecondMapAdapter','CEAdapterProbeSaveFormatVersion');",
            "ceProbeVersion(GalaxyPtr(),CurTurn());",
            "unknown ceSurveyClusters = ImportedFunction('CESecondMapAdapter','CEAdapterSurveyClusterList');",
            "ceSurveyClusters(GalaxyPtr());",
            "unknown cePollSecondHome = ImportedFunction('CESecondMapAdapter','CEAdapterPollSecondHomeTransform');",
            "cePollSecondHome(GalaxyPtr(),1128616787);",
            "unknown ceLiveArmSwitch = ImportedFunction('CESecondMapAdapter','CEAdapterInstallLiveArmSwitch');",
            "if(ceLiveArmSwitch(GalaxyPtr(),1128616787)) {",
            "unknown ceSetSystemSector = ImportedFunction('CESecondMapAdapter','CEAdapterSetSystemSector');",
            "unknown ceCapturePlanet = ImportedFunction('CESecondMapAdapter','CEAdapterCapturePlanetName');",
            "unknown ceCaptureStation = ImportedFunction('CESecondMapAdapter','CEAdapterCaptureStationName');",
            "dword ceSystemIndex = 0;",
            "while(ceSystemIndex<GalaxyStars()) {",
            "  unknown ceArmStar = GalaxyStar(ceSystemIndex);",
            "  ceSetSystemSector(GalaxyPtr(),ceSystemIndex,StarToCon(ceArmStar));",
            "  dword cePlanetIndex = 0;",
            "  while(cePlanetIndex<StarPlanets(ceArmStar)) {",
            "    ceCapturePlanet(GalaxyPtr(),StarPlanets(ceArmStar,cePlanetIndex));",
            "    cePlanetIndex=cePlanetIndex+1;",
            "  }",
            "  dword ceStationIndex = 0;",
            "  while(ceStationIndex<StarRuins(ceArmStar)) {",
            "    ceCaptureStation(GalaxyPtr(),StarRuins(ceArmStar,ceStationIndex));",
            "    ceStationIndex=ceStationIndex+1;",
            "  }",
            "  ceSystemIndex=ceSystemIndex+1;",
            "}",
            "}",
            "if(ShipInHole(Player())) {",
            "  unknown ceEnterPortal = ImportedFunction('CESecondMapAdapter','CEAdapterEnterRegisteredPortal');",
            "  ceEnterPortal(GalaxyPtr(),Id(ShipOrderObj(Player())));",
            "} else {",
            "  unknown cePortalStatus = ImportedFunction('CESecondMapAdapter','CEAdapterPortalStatus');",
            "  unknown ceCompletePortal = ImportedFunction('CESecondMapAdapter','CEAdapterCompleteRegisteredPortal');",
            "  if(cePortalStatus()==2 && ceCompletePortal(GalaxyPtr())) {",
            "    ShipDeleteCustomShipInfo(Player(),'CE_InterarmPortalWatch');",
            "    unknown ceActiveArm = ImportedFunction('CESecondMapAdapter','CEAdapterActiveArm');",
            "    if(ceActiveArm()==1) {",
            "      unknown ceArrivalSector = StarToCon(ShipStar(Player()));",
            "      SectorVisible(ceArrivalSector,1);",
            "      dword ceSectorIndex = 0;",
            "      dword ceOpened = 0;",
            "      while(ceSectorIndex<GalaxySectors() && ceOpened<2) {",
            "        unknown ceCandidateSector = GalaxySectors(ceSectorIndex);",
            "        if(ceCandidateSector!=ceArrivalSector && ConNear(ceArrivalSector,ceCandidateSector)) {",
            "          SectorVisible(ceCandidateSector,1);",
            "          ceOpened=ceOpened+1;",
            "        }",
            "        ceSectorIndex=ceSectorIndex+1;",
            "      }",
            "    }",
            "  }",
            "}",
            "unknown ceProbeSectorBefore = ImportedFunction('CESecondMapAdapter','CEAdapterProbeSectorFlagBefore');",
            "unknown ceProbeSectorAfter = ImportedFunction('CESecondMapAdapter','CEAdapterProbeSectorFlagAfter');",
            "dword ceProbeSecIndex = 0;",
            "dword ceProbeSecFound = 0;",
            "while(ceProbeSecIndex<GalaxySectors() && !ceProbeSecFound) {",
            "  unknown ceProbeSector = GalaxySectors(ceProbeSecIndex);",
            "  if(SectorVisible(ceProbeSector)==0) {",
            "    if(ceProbeSectorBefore(ceProbeSector)) {",
            "      SectorVisible(ceProbeSector,1);",
            "      ceProbeSectorAfter(ceProbeSector);",
            "    }",
            "    ceProbeSecFound=1;",
            "  }",
            "  ceProbeSecIndex=ceProbeSecIndex+1;",
            "}",
            "unknown ceBeginSurvey = ImportedFunction('CESecondMapAdapter','CEAdapterBeginSectorSurvey');",
            "if(ceBeginSurvey()) {",
            "  unknown ceDumpSectorIdx = ImportedFunction('CESecondMapAdapter','CEAdapterDumpSectorIndexed');",
            "  dword ceSurveyIndex = 0;",
            "  while(ceSurveyIndex<GalaxySectors()) {",
            "    unknown ceSurveySector = GalaxySectors(ceSurveyIndex);",
            "    ceDumpSectorIdx(ceSurveySector,ceSurveyIndex);",
            "    Ether(6,'CE_Sector<ceSurveyIndex>','Сектор <ceSurveyIndex>: <ConName(ceSurveySector)>');",
            "    ceSurveyIndex=ceSurveyIndex+1;",
            "  }",
            "  if(GalaxySectors()>1)",
            "  {",
            "    unknown ceTestSector=GalaxySectors(0);",
            "    Ether(6,'CE_IndexTestBefore','ТЕСТ ДО: <ConName(ceTestSector)>');",
            "    unknown ceSetSectorIndex = ImportedFunction('CESecondMapAdapter','CEAdapterSetSectorIndex');",
            "    ceSetSectorIndex(ceTestSector,2);",
            "    Ether(6,'CE_IndexTestAfter','ТЕСТ ПОСЛЕ (ожидаю Хиша): <ConName(ceTestSector)>');",
            "  }",
            "}",
            "unknown ceConsumeCheat = ImportedFunction('CESecondMapAdapter','CEAdapterConsumeCheatTrigger');",
            "if(ceConsumeCheat()) {",
            "  unknown ceAnchor=0;",
            "  dword ceItemIndex=1;",
            "  while(ceItemIndex<ShipItems(Player())) {",
            "    unknown ceCandidate=ShipItems(Player(),ceItemIndex);",
            "    if(EquipmentImageName(ceCandidate)=='CE_Item_TwinHomeAnchor') ceAnchor=ceCandidate;",
            "    ceItemIndex=ceItemIndex+1;",
            "  }",
            "  if(!ceAnchor) {",
            "    ceAnchor=CreateQuestItem('CE_Item_TwinHomeAnchor',None);",
            "    NoDropItem(ceAnchor,1);",
            "    CanSellItem(ceAnchor,0);",
            "    AddItemToShip(Player(),ceAnchor);",
            "    UpdateFormShip();",
            "    Ether(6,'CE_AnchorGranted',CT('CE.Transit.AnchorGranted'));",
            "  } else {",
            "    NoDropItem(ceAnchor,1);",
            "    CanSellItem(ceAnchor,0);",
            "    Ether(6,'CE_AnchorAlreadyAboard',CT('CE.Transit.AnchorAlreadyAboard'));",
            "  }",
            "}"
          ]
        }
      ],
