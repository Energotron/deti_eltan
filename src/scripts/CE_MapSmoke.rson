          "Code.Type": "Turn",
          "Code": [
            "unknown ceProbeRawPtr = ImportedFunction('CESecondMapAdapter','CEAdapterProbeRawGalaxyPointer');",
            "ceProbeRawPtr(GalaxyPtr(),CurTurn());",
            "unknown ceCheckExternalReload = ImportedFunction('CESecondMapAdapter','CEAdapterCheckForExternalReload');",
            "if(ceCheckExternalReload(GalaxyPtr())) Ether(6,'CE_ExternalReload','Второй Дом: связь со Вторым Домом потеряна (похоже, была загрузка сохранения), состояние сброшено.');",
            "unknown ceLogHeartbeat = ImportedFunction('CESecondMapAdapter','CEAdapterLogTurnHeartbeat');",
            "ceLogHeartbeat(CurTurn(),ShipInHole(Player()));",
            "unknown ceLogABTest = ImportedFunction('CESecondMapAdapter','CEAdapterLogABTestEvent');",
            "ceLogABTest(CurTurn(),ShipInHole(Player()),GABStatus);",
            "//AB-TEST-DISABLED-PIVOTING-BACK-TO-PURE-NATIVE-TRANSIT: map_2 with one real ship didn't crash (after latching the double-fire bug), but even working correctly it never produced a visible \"fly out of the hole\" moment -- it only ever showed combat, then the player just appeared in Second Home once GalaxySectors()/TransferShip ran, same as before. Also once caused an apparent external autosave reload (CurTurn() jumped backwards) that this mod does not itself perform, most likely a side effect of the double-fire bug's overlapping AB requests confusing the engine. Abandoning arcade-as-loading-cover; going back to studying the plain ~438ms ShipInHole()-flips-false window instead. ceLogABTest above stays on (harmless) as a free baseline for this next round.",
            "unknown ceConsumeCameraRecenter = ImportedFunction('CESecondMapAdapter','CEAdapterConsumeCameraRecenterPending');",
            "if(ceConsumeCameraRecenter()) {",
            "  StarMapCenterView(CoordX(Player()),CoordY(Player()));",
            "  if(CurrentForm()=='StarMap') {",
            "    unknown ceClearCameraRecenter = ImportedFunction('CESecondMapAdapter','CEAdapterClearCameraRecenterPending');",
            "    ceClearCameraRecenter();",
            "  }",
            "}",
            "unknown ceSmoke = ImportedFunction('CESecondMapAdapter','CEAdapterRunSmoke');",
            "ceSmoke(GalaxyPtr(),1128616787);",
            "unknown ceProbe = ImportedFunction('CESecondMapAdapter','CEAdapterProbeGalaxy');",
            "ceProbe(GalaxyPtr(),64);",
            "unknown ceLayout = ImportedFunction('CESecondMapAdapter','CEAdapterObserveGalaxyLayout');",
            "ceLayout(GalaxyPtr(),1128616787,CurTurn());",
            "unknown ceProbeVersion = ImportedFunction('CESecondMapAdapter','CEAdapterProbeSaveFormatVersion');",
            "ceProbeVersion(GalaxyPtr(),CurTurn());",
            "unknown ceSurveyClusters = ImportedFunction('CESecondMapAdapter','CEAdapterSurveyClusterList');",
            "ceSurveyClusters(GalaxyPtr());",
