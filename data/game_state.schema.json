  "migrations": [
    {
      "from_version": 1,
      "to_version": 2,
      "operations": [
        {"when": {"vCE_OrphanState": "CONTACTED"}, "set": {"vCE_OrphanState": "ACTIVE"}},
        {"when": {"vCE_OrphanState": "SAMPLED"}, "set": {"vCE_OrphanState": "ACTIVE", "vCE_OrphanSampleTaken": true}},
        {"when": {"vCE_BlazerSecondHome": "DORMANT"}, "set": {"vCE_BlazerSecondHome": "TRACKING"}},
        {"when": {"vCE_BlazerSecondHome": "EXTINCT"}, "set": {"vCE_BlazerSecondHome": "INELIGIBLE"}},
        {"when": {"vCE_KellerSecondHome": "DORMANT"}, "set": {"vCE_KellerSecondHome": "TRACKING"}},
        {"when": {"vCE_KellerSecondHome": "EXTINCT"}, "set": {"vCE_KellerSecondHome": "INELIGIBLE"}},
        {"when": {"vCE_TerronSecondHome": "DORMANT"}, "set": {"vCE_TerronSecondHome": "TRACKING"}},
        {"when": {"vCE_TerronSecondHome": "EXTINCT"}, "set": {"vCE_TerronSecondHome": "INELIGIBLE"}},
        {"when_in": {"vCE_PirateSecondHome": ["LOCKED", "EXTINCT", "UNRESOLVED"]}, "set": {"vCE_PirateSecondHome": "INELIGIBLE"}},
        {"when": {"vCE_PirateSecondHome": "SCOUTING"}, "set": {"vCE_PirateSecondHome": "STEALING_TECH"}}
      ]
    },
    {
      "from_version": 2,
      "to_version": 3,
      "operations": [
        {"when": {"vCE_WarApartState": "COALITION_VICTORY"}, "set": {"vCE_PirateClanExistsAtCorridor": "NO"}},
        {"when_in": {"vCE_WarApartState": ["NOT_STARTED", "CLAN_ACTIVE", "PIRATE_VICTORY"]}, "set": {"vCE_PirateClanExistsAtCorridor": "YES"}},
        {"when": {"vCE_WarApartState": "PLAYER_PIRATE"}, "set": {"vCE_PlayerPirateStatus": true}}
      ]
    }
  ]
}
